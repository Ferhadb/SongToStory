# Spotify Web API (optional; without it, falls back to oEmbed/OG tags)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# YouTube Data API v3 (optional; needed for ranked search)
YOUTUBE_API_KEY=
# Audio acquisition via yt-dlp (personal use; see README caveat)
ENABLE_YTDLP=true
REDIS_URL=redis://localhost:6379/0
DATA_DIR=./data

# --- Video export ---
# Chrome/Chromium used by the renderer. Auto-detected on macOS/Linux; set to override.
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# URL the renderer's browser uses to fetch covers/audio from the API.
# RENDER_ASSET_BASE=http://localhost:8000/api/v1/assets
# RENDER_TIMEOUT_S=900
