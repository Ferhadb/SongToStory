# The Next.js editor. /api/v1/* is proxied to the API; the target is fixed at build time (next.config rewrites).
FROM node:22-bookworm-slim AS build
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web apps/web
COPY packages/compositions packages/compositions
RUN pnpm install --frozen-lockfile --filter web...
ARG API_URL=http://api:8000
ENV API_URL=$API_URL
RUN pnpm --filter web build

FROM node:22-bookworm-slim
RUN corepack enable
WORKDIR /app
COPY --from=build /app /app
ENV NODE_ENV=production
EXPOSE 3000
CMD ["pnpm", "--filter", "web", "start", "--port", "3000", "--hostname", "0.0.0.0"]
